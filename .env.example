# Copy to .env — never commit .env.
APP_ENV=local
DATABASE_URL=postgresql+psycopg://steg:changeme@postgres:5432/steg
REDIS_URL=redis://redis:6379/0
JWT_SIGNING_KEY=generate-a-real-secret-locally   # python -c "import secrets; print(secrets.token_urlsafe(64))"
ACCESS_TOKEN_LIFETIME_MINUTES=15
REFRESH_TOKEN_LIFETIME_DAYS=7
MAX_UPLOAD_BYTES=10485760          # 10 MiB
MAX_IMAGE_DIMENSION=4096
MAX_DECODED_PIXELS=16000000
MAX_PAYLOAD_BYTES=65536            # 64 KiB
STEGO_RETENTION_MINUTES=30
PLAINTEXT_RETENTION_MINUTES=5
TMP_STORAGE_DIR=/tmp/steg-artifacts
LOG_LEVEL=INFO
